{
  "name": "cubadevops/flexi-module-auth",
  "description": "Authentication and Authorization module for Flexi Framework",
  "version": "2.0.0",
  "type": "flexi-module",
  "license": "MIT",
  "keywords": [
    "flexi",
    "module",
    "authentication",
    "authorization",
    "jwt",
    "basic-auth"
  ],
  "authors": [
    {
      "name": "Carlos Batista",
      "email": "info@carlosbatista.dev",
      "homepage": "https://carlosbatista.dev"
    }
  ],
  "require": {
    "php": ">=7.4",
    "firebase/php-jwt": "^6.10",
    "flexi/contracts": "^5.2.1",
    "cubadevops/flexi-module-session": "^2.0",
    "cubadevops/flexi-module-logging": "^2.0",
    "psr/container": "^2.0",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^1.1",
    "psr/http-factory": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Flexi\\Modules\\Auth\\": ""
    }
  },
  "extra": {
    "flexi": {
      "module-name": "Auth",
      "module-type": "infrastructure",
      "config-files": [
        "Config/credentials.json",
        "Config/routes.json",
        "Config/services.json"
      ],
      "provides": [
        "authentication",
        "authorization",
        "jwt-middleware",
        "basic-auth-middleware"
      ],
      "schema-version": 1,
      "compatibility": {
        "core": "^3.2"
      }
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flexi\\Modules\\Auth\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "guzzlehttp/psr7": "^2.7"
  }
}
