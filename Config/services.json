{
  "services": [
    {
      "name": "Flexi\\Contracts\\Interfaces\\SecretProviderInterface",
      "class": {
        "name": "Flexi\\Modules\\Auth\\Infrastructure\\Adapters\\ConfigurationSecretProvider",
        "arguments": [
          "@Flexi\\Contracts\\Interfaces\\ConfigurationInterface"
        ]
      }
    },
    {
      "name": "auth_check_middleware",
      "class": {
        "name": "Flexi\\Modules\\Auth\\Infrastructure\\Middlewares\\AuthCheckMiddleware",
        "arguments": [
          "@Flexi\\Contracts\\Interfaces\\SessionStorageInterface",
          "@Psr\\Http\\Message\\ResponseFactoryInterface",
          "@Flexi\\Contracts\\Interfaces\\EventBusInterface",
          "@Psr\\Log\\LoggerInterface",
          "ENV.AUTH_SESSION_TIMEOUT"
        ]
      }
    },
    {
      "name": "jwt_auth_middleware",
      "class": {
        "name": "Flexi\\Modules\\Auth\\Infrastructure\\Middlewares\\JWTAuthMiddleware",
        "arguments": [
          "@Flexi\\Contracts\\Interfaces\\SecretProviderInterface",
          "@Psr\\Http\\Message\\ResponseFactoryInterface"
        ]
      }
    },
    {
      "name": "Flexi\\Modules\\Auth\\Domain\\Interfaces\\CredentialsRepositoryInterface",
      "class": "Flexi\\Modules\\Auth\\Infrastructure\\Adapters\\ConfigurationCredentialsRepository"
    },
    {
      "name": "Flexi\\Modules\\Auth\\Domain\\Interfaces\\CredentialsVerifierInterface",
      "class": "Flexi\\Modules\\Auth\\Infrastructure\\Adapters\\DefaultCredentialsVerifier"
    },
    {
      "name": "basic_auth_middleware",
      "class": {
        "name": "Flexi\\Modules\\Auth\\Infrastructure\\Middlewares\\BasicAuthMiddleware",
        "arguments": [
          "@Flexi\\Modules\\Auth\\Domain\\Interfaces\\CredentialsRepositoryInterface",
          "@Flexi\\Modules\\Auth\\Domain\\Interfaces\\CredentialsVerifierInterface",
          "@Flexi\\Contracts\\Interfaces\\SessionStorageInterface",
          "@Psr\\Http\\Message\\ResponseFactoryInterface",
          "@Flexi\\Contracts\\Interfaces\\EventBusInterface",
          "@Psr\\Log\\LoggerInterface"
        ]
      }
    },
    {
      "name": "Flexi\\Modules\\Auth\\Domain\\Interfaces\\AuthorizationProviderInterface",
      "class": "Flexi\\Modules\\Auth\\Infrastructure\\Adapters\\RoleBasedAuthorizationProvider"
    },
    {
      "name": "authorization_middleware",
      "class": {
        "name": "Flexi\\Modules\\Auth\\Infrastructure\\Middlewares\\AuthorizationMiddleware",
        "arguments": [
          "@Flexi\\Modules\\Auth\\Domain\\Interfaces\\AuthorizationProviderInterface",
          "@Psr\\Http\\Message\\ResponseFactoryInterface",
          "@Flexi\\Contracts\\Interfaces\\EventBusInterface",
          "@Psr\\Log\\LoggerInterface"
        ]
      }
    },
    {
      "name": "login_controller",
      "class": {
        "name": "Flexi\\Modules\\Auth\\Infrastructure\\Controllers\\LoginController",
        "arguments": [
          "@Psr\\Http\\Message\\ResponseFactoryInterface",
          "@Flexi\\Contracts\\Interfaces\\SessionStorageInterface",
          "@Flexi\\Contracts\\Interfaces\\EventBusInterface"
        ]
      }
    }
  ]
}
